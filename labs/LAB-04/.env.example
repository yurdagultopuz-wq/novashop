# ==============================================================================
# NovaShop LAB-04: AWS 3-Tier Production Environment Configuration
# ==============================================================================
# Kullanım:
#   1. cp .env.example .env
#   2. nano .env  # Kendi AWS ve RDS değerlerinizi girin
#   3. set -a && source .env && set +a  # Tüm değişkenleri ortama aktarın
# ==============================================================================

# --- 1. AWS Kimlik ve Bölge Parametreleri (Gerekirse) ---
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# --- 2. EC2 Sunucu ve Güvenlik Grubu ---
EC2_PUBLIC_IP=3.120.45.67
KEY_PATH=~/.ssh/novashop-key.pem
WEB_SG_ID=sg-0123456789abcdef0

# --- 3. RDS MySQL Veritabanı Parametreleri (Private Subnet) ---
RDS_ENDPOINT=novashop-catalog-db.cxxxx.rds.amazonaws.com
DB_PORT=3306
DB_NAME=catalogdb
DB_USER=novashop
DB_PASSWORD=ChangeMeStrongPassword123!

# Birleşik Endpoint (Host:Port)
DB_ENDPOINT=${RDS_ENDPOINT}:${DB_PORT}

# --- 4. Alan Adı / Domain & Portlar ---
# Özel alan adınız yoksa EC2_PUBLIC_IP kullanılır
DOMAIN=${EC2_PUBLIC_IP}
UI_PORT=8888
CATALOG_PORT=8081

# --- 5. Üretim Düzeyi İmaj Etiketleri ---
CATALOG_IMAGE=public.ecr.aws/aws-containers/retail-store-sample-catalog:1.6.2
UI_IMAGE=public.ecr.aws/aws-containers/retail-store-sample-ui:1.6.2
