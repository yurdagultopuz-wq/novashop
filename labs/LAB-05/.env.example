# --- 1. Docker Hub Kimlik Bilgileri (GitHub Secret) ---
# Docker Hub hesabınızdan (Account Settings > Security > Access Tokens) üretin:
DOCKERHUB_USERNAME=kullanici_adiniz
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxx

# --- 2. AWS Kimlik Bilgileri (GitHub Secret - EC2 Oluşturmak İçin) ---
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- 3. AWS Bölgesi (GitHub Variable) ---
AWS_REGION=us-east-1

# --- 4. EC2 Dağıtım Hedefi (Altyapı Workflow'u Tarafından Üretilir) ---
# GitHub Variables:
EC2_HOST=3.120.45.67
EC2_USER=ubuntu

# GitHub Secret:
