{
  "family": "novashop-ui",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/novashop-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/novashop-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "ui",
      "image": "public.ecr.aws/aws-containers/retail-store-sample-ui:1.6.2",
      "essential": true,
      "user": "appuser",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "JAVA_TOOL_OPTIONS",
          "value": "-XX:MaxRAMPercentage=75.0"
        },
        {
          "name": "ENDPOINTS_CATALOG",
          "value": "http://catalog.novashop.local:8080"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/novashop-ui",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ui"
        }
      }
    }
  ]
}
