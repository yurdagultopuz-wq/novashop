# NovaShop M04 AWS 3-Tier Ortam Değişkenleri Şablonu
# Kullanım: Bu dosyayı .env olarak kopyalayın ve RDS endpoint ile parolanızı girin.
# Asla gerçek şifre içeren .env dosyasını Git'e commit etmeyin (.gitignore korumalıdır).

# 1. AWS RDS MySQL Veritabanı Bilgileri (Private Subnet)
DB_ENDPOINT=novashop-catalog-db.cxxxx.us-east-1.rds.amazonaws.com
DB_NAME=catalogdb
DB_USER=novashop
DB_PASSWORD=REPLACE_WITH_SECRETS_MANAGER_GENERATED_PASSWORD
DB_PORT=3306

# 2. Mikroservis İletişim Uç Noktaları (Dahili Bridge Ağı)
ENDPOINTS_CATALOG=http://catalog:8080

# 3. Çalışma Profili ve JVM Yapılandırması
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# 4. İmaj Etiketleri (Asla :latest kullanılmaz)
NOVASHOP_UI_TAG=v0.1.0
NOVASHOP_CATALOG_TAG=1.6.2
